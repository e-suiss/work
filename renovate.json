{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "T-60: dependency updates wait 7 days unless they fix a known vulnerability; every update passes the tests and cargo-vet.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Rust crates in one pull request (T-60).",
      "matchManagers": [
        "cargo"
      ],
      "groupName": "rust dependencies"
    },
    {
      "description": "GitHub Actions stay pinned to a commit SHA with a version comment (T-60).",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "description": "The Rust toolchain is pinned in rust-toolchain.toml and adopted after the same cooldown (T-33, T-60).",
      "matchDepNames": [
        "rust"
      ],
      "groupName": "rust toolchain"
    }
  ]
}
