  "query": "SELECT size AS \"size!\", root::bytea AS \"root!\", signed_note AS \"signed_note!\",\n                      (extract(epoch FROM issued_at) * 1000)::bigint AS \"issued_at_ms!\"\n               FROM ledger.checkpoint\n               WHERE ledger_id = $1 AND size > $2\n               ORDER BY size LIMIT 1",
