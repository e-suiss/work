  "query": "SELECT witness_id::text AS \"witness_id!\",\n                      (extract(epoch FROM cosigned_at) * 1000)::bigint AS \"at!\",\n                      signature AS \"signature!\"\n               FROM ledger.checkpoint_cosignature\n               WHERE ledger_id = $1 AND size = $2 AND cosign_kind = 'witness'\n               ORDER BY witness_id",
