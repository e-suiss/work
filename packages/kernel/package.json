{
  "name": "@esuiss/work-kernel",
  "version": "0.0.0",
  "description": "TypeScript wrapper of the Work kernel. Kernel semantics come from the Rust kernel compiled to WebAssembly.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "wasm"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "startup": "node scripts/wasm-startup.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.9",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
