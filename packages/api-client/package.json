{
  "name": "@esuiss/work-api-client",
  "version": "0.0.0",
  "description": "Typed client of the Work REST API, generated from sdks/openapi/work-v1.json.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-suiss/work.git",
    "directory": "packages/api-client"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../sdks/openapi/work-v1.json --empty-objects-unknown --output src/generated/work-v1.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.9",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
